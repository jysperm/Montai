Overview: {{{overview}}}
{{#if location}}
Location: {{location}}
{{/if}}
{{#if timeOfDay}}
Time: {{timeOfDay}}
{{/if}}
{{#if segments}}
Segments:
{{#each segments}}
- {{this.startTime}}-{{this.endTime}}: {{this.description}}
{{#if this.qualityNotes}}
  Quality: {{this.qualityNotes}}
{{/if}}
{{#if this.speechContent}}
  Speech: {{this.speechContent}}
{{/if}}
{{/each}}
{{/if}}
{{#if highlights}}
Highlights:
{{#each highlights}}
- {{this.startTime}}-{{this.endTime}}: {{this.reason}}
{{/each}}
{{/if}}
{{#if technicalNotes}}
Technical: {{{technicalNotes}}}
{{/if}}