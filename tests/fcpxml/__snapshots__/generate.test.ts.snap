                            </text-style-def>
                        </title>
                    </asset-clip>
                    <transition offset="292/30s" duration="16/30s">
                        <filter-video ref="r3" name="Cross Dissolve" />
                        <filter-audio ref="r4" name="Audio Cross Fade" />
                    </transition>
                    <asset-clip ref="asset-1" name="landscape.mp4" offset="300/30s" duration="150/30s" start="600/30s" tcFormat="NDF">
                        <adjust-crop mode="pan">
                            <pan-rect left="0" top="0" right="0" bottom="0" />
                            <pan-rect left="35" top="30" right="35" bottom="30" />
                        </adjust-crop>
                        <title ref="r2" lane="1" name="Ken Burns" offset="600/30s" duration="135/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
                            <text>
                                <text-style ref="ts3" alignment="center">Ken Burns</text-style>
                            </text>
                            <text-style-def id="ts3">
                                <text-style font="Helvetica Neue" fontSize="64" fontFace="Regular" fontColor="1 1 1 1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                    </asset-clip>
                    <transition offset="442/30s" duration="16/30s">
                        <filter-video ref="r3" name="Cross Dissolve" />
                        <filter-audio ref="r4" name="Audio Cross Fade" />
                    </transition>
                    <asset-clip ref="asset-2" name="portrait-misoriented.mp4" offset="450/30s" duration="150/30s" start="300/30s" tcFormat="NDF">
                        <adjust-crop mode="pan">
