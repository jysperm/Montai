exports[`voiceover-test > FCP snapshot (voiceover + background music) 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="1/30s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)" />
        <effect id="r2" name="Basic Title" uid=".../Titles.localized/Essential Titles.localized/Essential Title.localized/Essential Title.moti" />
        <asset id="asset-1" start="0/1s" duration="900/30s" hasVideo="1" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000" format="r1">
            <media-rep kind="original-media" src="file:///fixtures/output/landscape.mp4" />
        </asset>
        <asset id="asset-2" start="0/1s" duration="900/30s" hasVideo="1" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000" format="r1">
            <media-rep kind="original-media" src="file:///fixtures/output/portrait-misoriented.mp4" />
        </asset>
        <asset id="audio-asset-1" start="0/1s" duration="5760000/48000s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///fixtures/output/music-long.wav" />
        </asset>
        <asset id="vo-asset-1" start="0/1s" duration="2016000/48000s" hasAudio="1" audioSources="1" audioChannels="1" audioRate="48000">
            <media-rep kind="original-media" src="file:///fixtures/output/narration.wav" />
        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="voiceover-test">
                <sequence format="r1" duration="900/30s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="landscape.mp4" offset="0/30s" duration="300/30s" start="0/30s" tcFormat="NDF">
                        <title ref="r2" lane="1" name="Voiceover segment 1" offset="0/30s" duration="300/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
                            <text>
                                <text-style ref="ts1" alignment="center">Voiceover segment 1</text-style>
                            </text>
                            <text-style-def id="ts1">
                                <text-style font="Helvetica Neue" fontSize="64" fontFace="Regular" fontColor="1 1 1 1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                        <asset-clip ref="audio-asset-1" lane="-1" name="music-long.wav" offset="0/30s" duration="900/30s" start="0/30s">

                            <adjust-volume amount="-16dB">
                                <param name="amount" value="-16dB">
                                    <fadeIn type="linear" duration="60/30s"/>
                                    <fadeOut type="linear" duration="60/30s"/>
                                </param>
                            </adjust-volume>
                        </asset-clip>
                        <asset-clip ref="vo-asset-1" lane="-2" name="narration.wav" offset="0/30s" duration="225/30s" start="75/30s" />
                    </asset-clip>
                    <asset-clip ref="asset-2" name="portrait-misoriented.mp4" offset="300/30s" duration="300/30s" start="0/30s" tcFormat="NDF">
                        <title ref="r2" lane="1" name="Voiceover segment 2" offset="0/30s" duration="300/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
                            <text>
                                <text-style ref="ts2" alignment="center">Voiceover segment 2</text-style>
                            </text>
                            <text-style-def id="ts2">
                                <text-style font="Helvetica Neue" fontSize="64" fontFace="Regular" fontColor="1 1 1 1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                        <asset-clip ref="vo-asset-1" lane="-3" name="narration.wav" offset="30/30s" duration="210/30s" start="450/30s" />
                    </asset-clip>
                    <asset-clip ref="asset-1" name="landscape.mp4" offset="600/30s" duration="300/30s" start="300/30s" tcFormat="NDF">
                        <title ref="r2" lane="1" name="Music only (no voiceover)" offset="300/30s" duration="300/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
                            <text>
                                <text-style ref="ts3" alignment="center">Music only (no voiceover)</text-style>
                            </text>
                            <text-style-def id="ts3">
                                <text-style font="Helvetica Neue" fontSize="64" fontFace="Regular" fontColor="1 1 1 1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                    </asset-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
"
`;
