                            </text-style-def>
                        </title>
                    </asset-clip>
                    <asset-clip ref="asset-2" name="portrait-misoriented.mp4" offset="150/30s" duration="150/30s" start="150/30s" tcFormat="NDF">
                        <adjust-crop mode="crop">
                            <crop-rect left="20" top="15" right="20" bottom="15" />
                        </adjust-crop>
                        <title ref="r2" lane="1" name="Static Crop" offset="150/30s" duration="135/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
