exports[`generateFcpxml > overlay animations: fade, slide, pop 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
    <resources>
        <format id="r1" name="FFVideoFormat1080p25" frameDuration="1/25s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)" />
        <format id="r5" name="FFVideoFormat1080p30" frameDuration="1001/30000s" width="1920" height="1080" />
        <effect id="r2" name="Basic Title" uid=".../Titles.localized/Essential Titles.localized/Essential Title.localized/Essential Title.moti" />
        <effect id="r3" name="Essential Fade" uid=".../Titles.localized/Essential Titles.localized/Essential Fade.localized/Essential Fade.moti" />
        <effect id="r4" name="Essential Scale" uid=".../Titles.localized/Essential Titles.localized/Essential Scale.localized/Essential Scale.moti" />
        <asset id="asset-1" start="0/1s" duration="1799798/30000s" hasVideo="1" hasAudio="1" format="r5">
            <media-rep kind="original-media" src="file:///test/video1.mp4" />
        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="anim-test">
                <sequence format="r1" duration="750/25s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="video1.mp4" offset="0/25s" duration="750/25s" start="0/25s" format="r5" tcFormat="NDF">
                        <title ref="r3" lane="1" name="Fade In" offset="0/25s" duration="125/25s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -928"/>
                            <text>
                                <text-style ref="ts1" alignment="center">Fade In</text-style>
                            </text>
                            <text-style-def id="ts1">
                                <text-style font="Helvetica Neue" fontSize="96" fontFace="Regular" fontColor="1 1 1 1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                        <title ref="r2" lane="2" name="Slide Up" offset="150/25s" duration="150/25s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101">
                                <keyframeAnimation>
                                    <keyframe time="0/1s" value="-1740 -1330" interp="linear"/>
                                    <keyframe time="8/25s" value="-1740 -928"/>
                                    <keyframe time="143/25s" value="-1740 -928" interp="linear"/>
                                    <keyframe time="150/25s" value="-1740 -1330"/>
                                </keyframeAnimation>
                            </param>
                            <text>
                                <text-style ref="ts2" alignment="left">Slide Up</text-style>
                            </text>
                            <text-style-def id="ts2">
                                <text-style font="Helvetica Neue" fontSize="96" fontFace="Regular" fontColor="1 1 1 1" alignment="left" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                        <title ref="r4" lane="3" name="Pop" offset="325/25s" duration="125/25s" start="0/1s">
                            <text>
                                <text-style ref="ts3" alignment="center">Pop</text-style>
                            </text>
                            <text-style-def id="ts3">
                                <text-style font="Helvetica Neue" fontSize="160" fontFace="Regular" fontColor="1 1 1 1" bold="1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                    </asset-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
"
`;

