exports[`transition-test > FCP snapshot 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
    <resources>
        <format id="r1" name="FFVideoFormat1080p30" frameDuration="1/30s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)" />
        <effect id="r2" name="Basic Title" uid=".../Titles.localized/Essential Titles.localized/Essential Title.localized/Essential Title.moti" />
        <effect id="r3" name="Cross Dissolve" uid="FxPlug:4731E73A-8DAC-4113-9A30-AE85B1761265" />
        <effect id="r4" name="Slide" uid="FxPlug:6AAB0D54-FCD8-4EBD-A62D-D352A5ED1648" />
        <effect id="r5" name="Wipe" uid="FxPlug:857E2FBA-98DB-411B-A88C-CE6ABC1F65D8" />
        <effect id="r6" name="Audio Cross Fade" uid="FFAudioTransition" />
        <asset id="asset-1" start="0/1s" duration="900/30s" hasVideo="1" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000" format="r1">
            <media-rep kind="original-media" src="file:///fixtures/output/landscape.mp4" />
        </asset>
        <asset id="asset-2" start="0/1s" duration="900/30s" hasVideo="1" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000" format="r1">
            <media-rep kind="original-media" src="file:///fixtures/output/portrait-misoriented.mp4" />
        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="transition-test">
                <sequence format="r1" duration="1650/30s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="landscape.mp4" offset="0/30s" duration="150/30s" start="0/30s" tcFormat="NDF">
                        <title ref="r2" lane="1" name="Hard Cut" offset="0/30s" duration="120/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
                            <text>
                                <text-style ref="ts1" alignment="center">Hard Cut</text-style>
                            </text>
                            <text-style-def id="ts1">
                                <text-style font="Helvetica Neue" fontSize="64" fontFace="Regular" fontColor="1 1 1 1" alignment="center" shadowColor="0 0 0 0.8" shadowOffset="4 4" shadowBlurRadius="16" />
                            </text-style-def>
                        </title>
                    </asset-clip>
                    <transition offset="135/30s" duration="30/30s">
                        <filter-video ref="r3" name="Cross Dissolve" />
                        <filter-audio ref="r6" name="Audio Cross Fade" />
                    </transition>
                    <asset-clip ref="asset-1" name="landscape.mp4" offset="150/30s" duration="150/30s" start="150/30s" tcFormat="NDF">
                        <title ref="r2" lane="1" name="Fade" offset="150/30s" duration="120/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
                            <text>
                                <text-style ref="ts2" alignment="center">Fade</text-style>
                            </text>
                            <text-style-def id="ts2">
