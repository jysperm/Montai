                            <adjust-volume amount="-8dB">
                                <param name="amount" value="-8dB">
                                    <fadeIn type="linear" duration="30/30s"/>
                                    <fadeOut type="linear" duration="30/30s"/>
                                </param>
                            </adjust-volume>
                        </asset-clip>
                    </asset-clip>
                    <asset-clip ref="asset-2" name="portrait-misoriented.mp4" offset="300/30s" duration="300/30s" start="0/30s" tcFormat="NDF">

