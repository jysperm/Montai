exports[`generateFcpxml > audio auto-loop: DaVinci uses alternating lanes 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
    <resources>
        <format id="r1" name="FFVideoFormat1080p25" frameDuration="1/25s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)" />
        <format id="r4" name="FFVideoFormat1080p30" frameDuration="1001/30000s" width="1920" height="1080" />
        <effect id="r2" name="Cross Dissolve" uid="FxPlug:4731E73A-8DAC-4113-9A30-AE85B1761265" />
        <effect id="r3" name="Audio Cross Fade" uid="FFAudioTransition" />
        <asset id="asset-1" start="0/1s" duration="1799798/30000s" hasVideo="1" hasAudio="1" format="r4">
            <media-rep kind="original-media" src="file:///test/video1.mp4" />
        </asset>
        <asset id="audio-asset-1" start="0/1s" duration="480000/48000s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///test/music.wav" />
        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="loop-davinci">
                <sequence format="r1" duration="750/25s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="video1.mp4" offset="0/25s" duration="750/25s" start="0/25s" format="r4" tcFormat="NDF">
                        <asset-clip ref="audio-asset-1" lane="-1" name="music.wav" offset="0/25s" duration="250/25s" start="0/25s">

                            <adjust-volume amount="-10dB">
                                <param name="amount" value="-10dB">
                                    <fadeIn type="linear" duration="50/25s"/>
                                    <fadeOut type="linear" duration="25/25s"/>
                                </param>
                            </adjust-volume>
                        </asset-clip>
                        <asset-clip ref="audio-asset-1" lane="-2" name="music.wav" offset="225/25s" duration="250/25s" start="0/25s">

                            <adjust-volume amount="-10dB">
                                <param name="amount" value="-10dB">
                                    <fadeIn type="linear" duration="25/25s"/>
                                    <fadeOut type="linear" duration="25/25s"/>
                                </param>
                            </adjust-volume>
                        </asset-clip>
                        <asset-clip ref="audio-asset-1" lane="-1" name="music.wav" offset="450/25s" duration="175/25s" start="0/25s">

                            <adjust-volume amount="-10dB">
                                <param name="amount" value="-10dB">
                                    <fadeIn type="linear" duration="25/25s"/>
                                    <fadeOut type="linear" duration="50/25s"/>
                                </param>
                            </adjust-volume>
                        </asset-clip>
                    </asset-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
"
`;

exports[`generateFcpxml > audio auto-loop: FCP uses spine with transitions 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
    <resources>
        <format id="r1" name="FFVideoFormat1080p25" frameDuration="1/25s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)" />
        <format id="r4" name="FFVideoFormat1080p30" frameDuration="1001/30000s" width="1920" height="1080" />
        <effect id="r2" name="Cross Dissolve" uid="FxPlug:4731E73A-8DAC-4113-9A30-AE85B1761265" />
        <effect id="r3" name="Audio Cross Fade" uid="FFAudioTransition" />
        <asset id="asset-1" start="0/1s" duration="1799798/30000s" hasVideo="1" hasAudio="1" format="r4">
            <media-rep kind="original-media" src="file:///test/video1.mp4" />
        </asset>
        <asset id="audio-asset-1" start="0/1s" duration="480000/48000s" hasAudio="1" audioSources="1" audioChannels="2" audioRate="48000">
            <media-rep kind="original-media" src="file:///test/music.wav" />
        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="loop-fcp">
                <sequence format="r1" duration="750/25s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="video1.mp4" offset="0/25s" duration="750/25s" start="0/25s" format="r4" tcFormat="NDF">
                        <spine lane="-1" offset="0/25s">
                            <asset-clip ref="audio-asset-1" name="music.wav" offset="0/25s" duration="238/25s" start="0/25s">

                                <adjust-volume amount="-10dB">
                                    <param name="amount" value="-10dB">
                                        <fadeIn type="linear" duration="50/25s"/>
                                    </param>
                                </adjust-volume>
                            </asset-clip>
                            <transition name="Cross Dissolve" offset="225/25s" duration="25/25s">
                                <filter-video ref="r2" name="Cross Dissolve" />
                                <filter-audio ref="r3" name="Audio Cross Fade" />
                            </transition>
                            <asset-clip ref="audio-asset-1" name="music.wav" offset="238/25s" duration="225/25s" start="13/25s">

                                <adjust-volume amount="-10dB"/>
                            </asset-clip>
                            <transition name="Cross Dissolve" offset="450/25s" duration="25/25s">
                                <filter-video ref="r2" name="Cross Dissolve" />
                                <filter-audio ref="r3" name="Audio Cross Fade" />
                            </transition>
                            <asset-clip ref="audio-asset-1" name="music.wav" offset="463/25s" duration="213/25s" start="13/25s">

                                <adjust-volume amount="-10dB">
                                    <param name="amount" value="-10dB">
                                        <fadeOut type="linear" duration="50/25s"/>
                                    </param>
                                </adjust-volume>
                            </asset-clip>
                        </spine>
                    </asset-clip>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
"
`;

