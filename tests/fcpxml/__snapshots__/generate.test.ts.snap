        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="crop-test">
                <sequence format="r1" duration="600/30s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="landscape.mp4" offset="0/30s" duration="150/30s" start="300/30s" tcFormat="NDF">
                        <title ref="r2" lane="1" name="No Crop" offset="300/30s" duration="150/30s" start="0/1s">
                            <param name="Position" key="9999/10085/10086/1/100/101" value="0 -952"/>
