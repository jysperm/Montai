exports[`generateFcpxml > slide and wipe transitions with direction params 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
    <resources>
        <format id="r1" name="FFVideoFormat1080p25" frameDuration="1/25s" width="1920" height="1080" colorSpace="1-1-1 (Rec. 709)" />
        <format id="r5" name="FFVideoFormat1080p30" frameDuration="1001/30000s" width="1920" height="1080" />
        <effect id="r2" name="Slide" uid="FxPlug:6AAB0D54-FCD8-4EBD-A62D-D352A5ED1648" />
        <effect id="r3" name="Wipe" uid="FxPlug:857E2FBA-98DB-411B-A88C-CE6ABC1F65D8" />
        <effect id="r4" name="Audio Cross Fade" uid="FFAudioTransition" />
        <asset id="asset-1" start="0/1s" duration="1799798/30000s" hasVideo="1" hasAudio="1" format="r5">
            <media-rep kind="original-media" src="file:///test/video1.mp4" />
        </asset>
        <asset id="asset-2" start="0/1s" duration="1799798/30000s" hasVideo="1" hasAudio="1" format="r5">
            <media-rep kind="original-media" src="file:///test/video2.mp4" />
        </asset>
    </resources>
    <library>
        <event name="Montai Export">
            <project name="slide-wipe">
                <sequence format="r1" duration="1250/25s" tcStart="0/1s" tcFormat="NDF">
                    <spine>
                    <asset-clip ref="asset-1" name="video1.mp4" offset="0/25s" duration="375/25s" start="125/25s" format="r5" tcFormat="NDF" />
                    <transition offset="362/25s" duration="26/25s">
                        <filter-video ref="r2" name="Slide">
                            <param name="Direction" key="4" value="2" />
                        </filter-video>
                        <filter-audio ref="r4" name="Audio Cross Fade" />
                    </transition>
                    <asset-clip ref="asset-2" name="video2.mp4" offset="375/25s" duration="500/25s" start="250/25s" format="r5" tcFormat="NDF" />
                    <transition offset="868/25s" duration="14/25s">
                        <filter-video ref="r3" name="Wipe">
                            <param name="Direction" key="13" value="1" />
                        </filter-video>
                        <filter-audio ref="r4" name="Audio Cross Fade" />
                    </transition>
                    <asset-clip ref="asset-1" name="video1.mp4" offset="875/25s" duration="375/25s" start="7/25s" format="r5" tcFormat="NDF" />
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
"
`;

